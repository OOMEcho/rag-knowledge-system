SERVER_PORT=8080
HTTP_CLIENT_CONNECT_TIMEOUT=2s
HTTP_CLIENT_READ_TIMEOUT=300s

POSTGRES_DB=rag_knowledge
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_PORT=5432
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/rag_knowledge

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.6:35b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_TEMPERATURE=0.2

RAG_VECTOR_DIMENSIONS=1024
RAG_VECTOR_BATCH_SIZE=1000
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_DEFAULT_SIMILARITY_THRESHOLD=0.65
RAG_HYBRID_ENABLED=true
RAG_RRF_K=60
RAG_CHANNEL_POOL_MULTIPLIER=2
MVC_ASYNC_REQUEST_TIMEOUT=600s
RAG_INGESTION_CHUNK_SIZE=800
RAG_INGESTION_MIN_CHUNK_SIZE_CHARS=350
RAG_INGESTION_MIN_CHUNK_LENGTH_TO_EMBED=5
RAG_INGESTION_MAX_NUM_CHUNKS=10000
RAG_INGESTION_WORKER_COUNT=2
RAG_INGESTION_QUEUE_CAPACITY=100
RAG_INGESTION_ALLOWED_FILE_EXTENSIONS=txt,md,markdown,pdf,doc,docx,ppt,pptx,xls,xlsx,csv,html,htm

RAG_UPLOAD_MAX_FILE_SIZE=50MB
RAG_UPLOAD_MAX_REQUEST_SIZE=60MB

RAG_ORPHAN_CLEANUP_ENABLED=true
RAG_ORPHAN_CLEANUP_CRON=0 0 3 * * *
RAG_ORPHAN_CLEANUP_MIN_FILE_AGE=1h

# 前后端分离跨域白名单：默认放行本地 Vite 开发服务器，生产改为前端实际域名（逗号分隔）
RAG_CORS_ALLOWED_ORIGINS=http://localhost:5173

# 生产部署使用 prod profile：强制开启 API Key 认证、关闭 Swagger、隐藏健康检查细节
# SPRING_PROFILES_ACTIVE=prod
# 本地调试认证时可单独开启：RAG_SECURITY_ENABLED=true
RAG_SECURITY_ENABLED=false
# 多个 Key 用英文逗号分隔，生产环境请使用足够长的随机字符串
RAG_API_KEYS=
RAG_API_KEY_HEADER=X-API-Key
RAG_RATE_LIMIT_ENABLED=true
RAG_RATE_LIMIT_RPM=120
RAG_RATE_LIMIT_RAG_RPM=30
